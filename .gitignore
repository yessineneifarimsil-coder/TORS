# Generated benchmark data
# ============================================================
data/generated/*
data/processed/*
data/audit/*

# Keep folders in Git
!data/generated/.gitkeep
!data/processed/.gitkeep
!data/audit/.gitkeep

# ============================================================
# Generated research outputs
# ============================================================
results/models/*
results/weights/*
results/diagnostics/*
results/logs/*

!results/models/.gitkeep
!results/weights/.gitkeep
!results/diagnostics/.gitkeep
!results/logs/.gitkeep

