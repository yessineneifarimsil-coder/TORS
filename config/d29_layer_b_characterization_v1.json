{
  "protocol_name": "d29_layer_b_characterization_v1",
  "status": "freeze_before_characterization_execution",
  "purpose": "Descriptive decision-geometry characterization of the already-retained D29 production response kernel.",
  "retention_effect": "none",
  "can_change_d29_retention": false,
  "can_change_corrected_eligible_set": false,
  "can_create_new_generator_gate": false,
  "pass_fail_thresholds": null,
  "generator": {
    "name": "d29_kernel",
    "production_module": "src/v4_0_f1_terminal_d29_kernel_evaluator.py",
    "formula": "g(o)=theta*o + 0.05*v*o*(1-o)",
    "structural_zero_policy": "exact_zero",
    "c8_c10_policy": "unchanged_from_frozen_baseline"
  },
  "seeds": {
    "development": [
      21001,
      21002,
      21003,
      21004,
      21005
    ],
    "primary_allowed": false,
    "reserve_allowed": false,
    "structural_validation_allowed": false
  },
  "contexts": {
    "pool": "estimation_master_fit_plus_weight",
    "n_contexts_per_seed": 1000,
    "external_test_used": false
  },
  "condition": {
    "rho": 0.4,
    "sigma_x": 0.0,
    "lambda": 0.5,
    "target_noise_used": false,
    "c": null,
    "N": 1000
  },
  "oracle": {
    "utility": "noise_free_U_star",
    "alpha_mapping": "primary_heterogeneous_fixed",
    "q_transform": "normalized_log1p_zeta_2",
    "interaction_graph": "frozen_primary_pairwise_graph",
    "winner_tolerance": 1e-12,
    "ranking_tolerance": 1e-12,
    "tie_rtol": 0.0,
    "tie_semantics": "decision_semantics_v1_anchor_average_ranks_and_true_max_top1"
  },
  "metrics_per_seed": [
    "distinct_complete_oracle_orderings",
    "distinct_deterministic_oracle_winners",
    "modal_oracle_winner_id",
    "modal_oracle_winner_share",
    "modal_baseline_mean_normalized_oracle_regret",
    "modal_baseline_median_normalized_oracle_regret",
    "modal_baseline_p95_normalized_oracle_regret",
    "undefined_normalized_regret_context_count"
  ],
  "ordering_representation": "tuple_of_anchor_average_ranks_in_A1_to_A6_order",
  "modal_tie_rule": "ascending_alternative_id",
  "normalized_regret": {
    "numerator": "U_star(best)-U_star(selected_modal)",
    "denominator": "max_a(U_star)-min_a(U_star)",
    "undefined_if_denominator_le": 1e-12,
    "epsilon_regularization": false
  },
  "cross_seed_summary": {
    "retain_all_seed_level_results": true,
    "summary_statistics": [
      "median",
      "min",
      "max"
    ],
    "winner_identity_is_not_an_optimization_target": true
  },
  "execution": {
    "one_shot": true,
    "result_overwrite_forbidden": true,
    "independent_read_only_audit_required_after_execution": true
  },
  "firewalls": {
    "external_test": true,
    "primary_seeds_11001_11030": true,
    "reserve_seeds_30001_30005": true,
    "Y": true,
    "xgboost": true,
    "shap": true,
    "mcdm_weight_methods": true,
    "preferred_ITS_winner": true
  }
}
